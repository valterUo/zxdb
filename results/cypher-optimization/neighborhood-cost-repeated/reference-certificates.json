  "audit_source": "\"\"\"Untimed transitive certificate using the recorded trusted PyZX reduction.\"\"\"\nimport json\nimport hashlib\nfrom pathlib import Path\nimport sys\nimport time\nsys.path.insert(0, str(Path.cwd()))\nfrom evaluation.core import certify_unitary_rewrite\nfrom evaluation.evidence import read_graph, save_graph, _ordered_audit_graph\nfrom evaluation.workloads import build\n\n\ndef main():\n    root = Path(sys.argv[1])\n    rows = [json.loads(x) for x in (root/'observations.jsonl').read_text().splitlines()]\n    assert 'Run state: finished.' in (root/'REPORT.md').read_text()\n    environment = json.loads((root/'environment.json').read_text())\n    for name, expected in environment['source_hashes'].items():\n        assert hashlib.sha256(Path(name).read_bytes()).hexdigest() == expected, name\n    selected = {}\n    for row in rows:\n        if row['stage'] == 'benchmark' and not row['warmup']:\n            keys = row['graph_evidence']\n            selected.setdefault((keys['original'], keys['db']), row)\n    report = {'method': 'Trusted PyZX full_reduce maps the hash-checked known-unitary original to the recorded reference; certify reference-adjoint composed with database output as nonzero ordered identity',\n              'selection': 'Every distinct measured original/database output pair',\n              'selected_pairs': len(selected), 'source_hashes': environment['source_hashes'],\n              'audit_source': Path(__file__).read_text(), 'attempts': []}\n    for row in selected.values():\n        report['attempts'].append(check(root, row))\n        (root/'reference-certificates.json').write_text(json.dumps(report, indent=2))\n        print(row['spec'], report['attempts'][-1]['certificate'], flush=True)\n\n\ndef check(root, row):\n    assert row['spec']['family'] in {'random_clifford', 'random_clifford_t', 'random_t_heavy', 'layered_local', 'layered_global'}\n    keys = row['graph_evidence']\n    original = build(row['spec'])\n    assert save_graph(root/'graphs', original) == keys['original']\n    reference = _ordered_audit_graph(read_graph(root/'graphs', keys['pyzx']))\n    result = _ordered_audit_graph(read_graph(root/'graphs', keys['db']))\n    assert save_graph(root/'graphs', reference) == keys['pyzx']\n    assert save_graph(root/'graphs', result) == keys['db']\n    start = time.perf_counter()\n    certificate = certify_unitary_rewrite(reference, result, 120)\n    return {'case': row['case'], 'spec': row['spec'], 'graph_evidence': keys,\n              'certificate': certificate, 'elapsed_s': time.perf_counter()-start,\n              'payload_hashes_preserved': True}\n\n\nif __name__ == '__main__':\n    main()\n",
